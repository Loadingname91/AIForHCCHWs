# =============================================================================
# CS6961 · AI for HCC — LLM backend configuration
#
#   cp .env.example .env      then edit the three lines under STEP 1.
#   .env is git-ignored. Never commit a real API key.
# =============================================================================

# -----------------------------------------------------------------------------
# STEP 1 — pick where your LLM runs. This is the only line most students touch.
#
#   ollama      local, free, offline      <- DEFAULT, recommended
#   lmstudio    local, free, GUI          (nice on Windows)
#   vllm        local, free, needs a GPU  (fast, advanced)
#   llamacpp    local, free, CPU-friendly (most manual)
#   groq        cloud, free tier, very fast
#   cerebras    cloud, free tier
#   gemini      cloud, free tier (Google)
#   openrouter  cloud, free models (":free" suffix)
#   hf          cloud, METERED  <- what the course docs use, burns your credits
#   openai      cloud, PAID     <- never required for this course
# -----------------------------------------------------------------------------
LLM_BACKEND=ollama

# -----------------------------------------------------------------------------
# STEP 2 — which model. Leave blank to use the backend's sensible default.
# Pick by VRAM; see docs/02-setup-ollama.md for the full table.
#
#   CPU only / 8 GB RAM ....... qwen3:1.7b        (weak, but it runs)
#   6-8 GB VRAM ............... qwen3:4b-instruct (good agent/size tradeoff)
#   12-16 GB VRAM ............. qwen3:8b          <- default
#   24 GB+ VRAM ............... qwen3:14b
#   32 GB+ VRAM ............... qwen3-coder:30b   (best tool use, MoE, fast)
# -----------------------------------------------------------------------------
OLLAMA_MODEL_ID=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama's default context window is small and it truncates SILENTLY, which
# looks like "my agent went stupid halfway through". Agents need a big one.
# NOTE: this reaches Ollama-native clients only. The server-wide setting
# OLLAMA_CONTEXT_LENGTH is the one that always works -- see docs/02.
OLLAMA_NUM_CTX=32768

# Hybrid Qwen3 tags (qwen3:8b, qwen3:14b) reason before answering, and Ollama
# returns that reasoning in a separate field while `content` stays EMPTY --
# which every agent framework reads as "the model said nothing".
# Leaving this true sends reasoning_effort="none", the only switch that
# actually works on the /v1 endpoint. See docs/02#thinking-models.
OLLAMA_DISABLE_THINKING=true

# -----------------------------------------------------------------------------
# STEP 3 — API keys, only for the cloud backends you actually use.
# -----------------------------------------------------------------------------

# Hugging Face. Optional, but Hub downloads (tokenizers, datasets, the
# embedding model) are rate-limited without one.
# Free: https://huggingface.co/settings/tokens
HF_TOKEN=

# Free-tier clouds. Sign up, copy key, paste. No credit card for any of these.
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys

# Paid. Optional. The course never requires it.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# STEP 4 — generation defaults. Low temperature = more parseable tool calls.
# -----------------------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300

# Local embedding model for the Unit 2.3 RAG examples (runs on CPU, ~90 MB).
EMBED_MODEL_ID=BAAI/bge-small-en-v1.5

# -----------------------------------------------------------------------------
# Optional: per-backend model overrides, so one .env can serve several backends.
# -----------------------------------------------------------------------------
# GROQ_MODEL_ID=llama-3.3-70b-versatile
# GEMINI_MODEL_ID=gemini-2.0-flash
# OPENROUTER_MODEL_ID=qwen/qwen3-8b:free
# HF_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
